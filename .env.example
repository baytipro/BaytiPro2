# BaytiPro — مثال متغيرات البيئة
# كوبي هاد الملف وسميه .env وعمّر القيم الحقيقية
# ⚠️ ملف .env الحقيقي لا يُرفع أبداً لـ GitHub!

# رابط قاعدة بيانات PostgreSQL (من Neon.tech)
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/baytipro?sslmode=require

# كلمة سر لوحة التحكم /admin
ADMIN_KEY=baytipro2026

# الرابط الرسمي للموقع (كيستعمل للمشاركة والسيو) — بدلو بالدومين ديالك ملي تنشر
NEXT_PUBLIC_SITE_URL=https://baytipro.vercel.app

# (اختياري) مفتاح CallMeBot لتنبيهات المالك على واتساب
# CALLMEBOT_APIKEY=

# (مستحسن) UltraMsg — باش الزبون يتوصل برسالة تأكيد أوتوماتيكية من الرقم ديالك
# ULTRAMSG_INSTANCE_ID=
# ULTRAMSG_TOKEN=

# (اختياري) WhatsApp Cloud API من Meta
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
